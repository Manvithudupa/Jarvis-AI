# ============================================================
#  J.A.R.V.I.S. AI Assistant — environment variables
# ============================================================
#  HOW TO USE:
#    1. Copy this file to .env  →  Windows:  copy .env.example .env
#                               →  Mac/Linux: cp .env.example .env
#    2. Fill in YOUR values. Nothing is auto-filled for you.
#    3. Restart the assistant afterwards.
#
#  ⚠️  Never commit your real .env file (it is gitignored).
#
#  The keys below are the only ones the assistant reads (weather, news,
#  web-search). Every feature has a key-free fallback, so you can leave
#  them empty and the assistant still works.
# ============================================================

# ── REQUIRED ─────────────────────────────────────────────────
# Your name — the assistant greets you by it.
USER=YourName

# What the assistant calls itself (shown on the HUD).
BOTNAME=JARVIS

# ── AI MODEL ─────────────────────────────────────────────────
# Local Ollama model used for everyday answers (default: qwen3:4b).
# A 1.7B model is too small to answer general-knowledge questions reliably —
# it invents facts. Pull a 4B model (or bigger) instead:
#   ollama pull qwen3:4b
MODEL=qwen3:4b
# Bigger model used for "ULTRATHINK:" questions. Leave empty to use MODEL;
# e.g. pull one with:  ollama pull qwen3:8b
BIG_MODEL=

# ── WEATHER ──────────────────────────────────────────────────
# Primary: WeatherAPI.com — free tier: 1,000,000 calls/month.
# Grab a key at https://www.weatherapi.com/signup.aspx
WEATHERAPI_KEY=
# Fallback: OpenWeatherMap — https://openweathermap.org/api
# (if WeatherAPI is empty AND this is empty, the key-free
#  wttr.in service answers automatically — no key needed)
OPENWEATHER_APP_ID=

# ── NEWS ─────────────────────────────────────────────────────
# Primary: GNews.io — free tier: 100 requests/day.
# https://gnews.io/
GNEWS_API_KEY=
# Fallback: NewsAPI.org (free developer tier).
# https://newsapi.org/
NEWS_API_KEY=

# ── WEB SEARCH ───────────────────────────────────────────────
# Optional fallback for the "google ..." / web-search command.
# Primary search uses DuckDuckGo (free, no key needed).
# https://serpapi.com/
SERPAPI_KEY=

# ── SPEECH-TO-TEXT (local, optional) ──────────────────────────
# When faster-whisper is installed (it's in requirements.txt), your voice is
# transcribed FULLY OFFLINE and Google's speech API is never used. The model
# downloads on first use and is cached.
#   tiny (39 MB, fastest) · base (75 MB, default) · small (~460 MB) · medium
WHISPER_MODEL=base
# cpu / cuda / auto (default: auto — uses CUDA when available)
WHISPER_DEVICE=auto
# int8 (default, fastest on CPU) / float16 / float32
WHISPER_COMPUTE_TYPE=int8
# en / hi / ... (default: en; leave empty to auto-detect each utterance)
WHISPER_LANGUAGE=en
